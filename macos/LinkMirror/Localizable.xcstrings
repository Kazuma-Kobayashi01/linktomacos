    "手机未连接": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机未连接"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone Not Connected"
          }
        },
        "ja": {
          "stringUnit": {
