    "在这个窗口里打开应用（⇧⌘A）": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这个窗口里打开应用（⇧⌘A）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open an app in this window (⇧⌘A)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウィンドウでアプリを開く（⇧⌘A）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這個視窗裡打開應用程式（⇧⌘A）"
          }
        }
      }
    },
    "增强服务已启动，现在可以拔掉数据线。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强服务已启动，现在可以拔掉数据线。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The enhanced service has started. You can unplug the cable now."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張サービスを起動しました。ケーブルを外しても大丈夫です。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增強服務已啟動，現在可以拔掉傳輸線了。"
          }
        }
      }
    },
    "增强服务没有启动。手机上的日志：%@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强服务没有启动。手机上的日志：%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The enhanced service did not start. Log from the phone: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張サービスが起動しませんでした。スマートフォンのログ：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增強服務沒有啟動。手機上的日誌：%@"
          }
        }
      }
    },
    "增强服务没有在预期时间内启动。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强服务没有在预期时间内启动。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The enhanced service did not start in time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張サービスが時間内に起動しませんでした。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增強服務沒有在預期時間內啟動。"
          }
        }
      }
    },
    "声音": {
      "localizations": {
        "zh-Hans": {
