    "展开通知栏": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "展开通知栏"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Notification Panel"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知パネルを開く"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "展開通知列"
          }
        }
      }
    },
    "应用已经在手机屏幕上打开时需要勾选，否则系统会直接把那个窗口调到前面，而不是开在这里。会丢失该应用未保存的状态。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用已经在手机屏幕上打开时需要勾选，否则系统会直接把那个窗口调到前面，而不是开在这里。会丢失该应用未保存的状态。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn this on if the app is already open on the phone’s screen; otherwise the system just brings that window forward instead of opening it here. Unsaved state in the app is lost."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリがスマートフォンの画面で既に開いている場合はオンにしてください。オフだと、ここで開かず、そのウィンドウが前面に出るだけです。アプリの未保存の状態は失われます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式已經在手機螢幕上開啟時需要勾選，否則系統只會把那個視窗移到最前面，而不是開在這裡。該應用程式未儲存的狀態會遺失。"
          }
        }
      }
    },
    "开关手机屏幕": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开关手机屏幕"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggle Phone Screen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末の画面をオン / オフ"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開關手機螢幕"
          }
        }
      }
    },
    "开关手机自己的屏幕，投屏不受影响（⇧⌘O）": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开关手机自己的屏幕，投屏不受影响（⇧⌘O）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the phone’s own screen off or on; mirroring is not affected (⇧⌘O)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォン本体の画面をオン／オフします。ミラーリングには影響しません（⇧⌘O）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開關手機本身的螢幕，螢幕鏡像不受影響（⇧⌘O）"
          }
        }
      }
    },
