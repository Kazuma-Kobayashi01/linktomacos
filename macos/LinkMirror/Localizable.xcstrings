    "检测到多部 USB 手机，请只连接一部。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到多部 USB 手机，请只连接一部。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than one phone is connected over USB. Please connect only one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のスマートフォンが USB 接続されています。1台だけ接続してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
