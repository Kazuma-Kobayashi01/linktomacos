          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機狀態"
          }
        }
      }
    },
    "打开 Link to macOS 配对后，这里会显示手机的状态。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Link to macOS 配对后，这里会显示手机的状态。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair a phone in Link to macOS and its status shows up here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Link to macOS でペアリングすると、ここにスマートフォンの状態が表示されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 Link to macOS 配對後，這裡會顯示手機的狀態。"
          }
        }
      }
    },
