    },
    "内存": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内存"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリ"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記憶體"
          }
        }
      }
    },
    "在桌面上看手机的电量、存储、内存和网络。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在桌面上看手机的电量、存储、内存和网络。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See your phone’s battery, storage, memory and network on the desktop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンのバッテリー、ストレージ、メモリ、ネットワークをデスクトップで確認できます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在桌面上看手機的電量、儲存、記憶體和網路。"
          }
        }
      }
    },
    "存储": {
      "localizations": {
        "zh-Hans": {
