        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機已經設定好，可以開始投屏了"
          }
        }
      }
    },
    "手机未授予相册读取权限，图片、视频、音频的占用暂时无法统计。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机未授予相册读取权限，图片、视频、音频的占用暂时无法统计。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone has not granted photo access, so usage by photos, videos, and audio can’t be counted yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンで写真へのアクセスが許可されていないため、写真・ビデオ・オーディオの使用量を集計できません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機未授予照片讀取權限，因此暫時無法統計圖片、影片和音訊的用量。"
          }
        }
      }
    },
