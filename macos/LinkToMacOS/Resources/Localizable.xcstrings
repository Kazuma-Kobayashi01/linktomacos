    "让 Android 手机与 Mac 互联：通知、相册与文件、投屏。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 Android 手机与 Mac 互联：通知、相册与文件、投屏。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connects your Android phone to your Mac: notifications, photos and files, and screen mirroring."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android スマートフォンと Mac をつなぎます：通知、写真とファイル、ミラーリング。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 Android 手機與 Mac 互聯：通知、照片與檔案、螢幕鏡像。"
          }
        }
      }
    },
