    "请先启动增强服务": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先启动增强服务"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start the enhanced service first"
          }
        },
        "ja": {
