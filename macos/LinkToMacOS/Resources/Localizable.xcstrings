    "原生": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブ"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原生"
          }
        }
      }
    },
    "原生：独立显示和手机屏幕一样大、dpi 也一样，应用显示与手机上完全一致；占用带宽很高，不适合热点。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生：独立显示和手机屏幕一样大、dpi 也一样，应用显示与手机上完全一致；占用带宽很高，不适合热点。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native: the separate display is the same size and dpi as the phone screen, so apps look exactly as they do on the phone. Uses a lot of bandwidth; not suitable for hotspots."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブ：独立ディスプレイがスマートフォンの画面と同じサイズ・同じ dpi になり、アプリの表示がスマートフォン上と完全に一致します。帯域を大きく使うため、テザリングには向きません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原生：獨立顯示器和手機螢幕一樣大、dpi 也一樣，應用程式的顯示與手機上完全一致；佔用頻寬很高，不適合行動熱點。"
          }
        }
      }
    },
    "取消": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "en": {
