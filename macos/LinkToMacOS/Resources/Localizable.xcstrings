            "value": "請先啟動增強服務"
          }
        }
      }
    },
    "请在手机上打开 Link to macOS，授予“所有文件访问”权限，然后回到这里。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在手机上打开 Link to macOS，授予“所有文件访问”权限，然后回到这里。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Link to macOS on your phone, grant “All files access”, then come back here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンで Link to macOS を開き、「すべてのファイルへのアクセス」を許可してから、ここに戻ってください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在手機上打開 Link to macOS，授予「所有檔案存取」權限，然後回到這裡。"
          }
        }
      }
    },
    "请在手机上打开 Link to macOS，授予“相册读取”权限（选择“允许全部”），然后回到这里。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在手机上打开 Link to macOS，授予“相册读取”权限（选择“允许全部”），然后回到这里。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Link to macOS on your phone, grant “Photo access” (choose “Allow all”), then come back here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンで Link to macOS を開き、「写真へのアクセス」を許可（「すべて許可」を選択）してから、ここに戻ってください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在手機上打開 Link to macOS，授予「照片讀取」權限（選擇「允許全部」），然後回到這裡。"
          }
        }
      }
    },
    "请在手机弹出的“允许 USB 调试吗？”里点“允许”。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在手机弹出的“允许 USB 调试吗？”里点“允许”。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the phone, tap Allow when asked “Allow USB debugging?”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末に表示される「USB デバッグを許可しますか？」で「許可」をタップしてください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
