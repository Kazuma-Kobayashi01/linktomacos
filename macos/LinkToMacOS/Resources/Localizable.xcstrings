    "请在手机上打开 LinkToMacOS，授予“所有文件访问”权限，然后回到这里。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在手机上打开 LinkToMacOS，授予“所有文件访问”权限，然后回到这里。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open LinkToMacOS on your phone, grant “All files access”, then come back here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンで LinkToMacOS を開き、「すべてのファイルへのアクセス」を許可してから、ここに戻ってください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在手機上打開 LinkToMacOS，授予「所有檔案存取」權限，然後回到這裡。"
          }
        }
      }
    },
    "请在手机上打开 LinkToMacOS，授予“相册读取”权限（选择“允许全部”），然后回到这里。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在手机上打开 LinkToMacOS，授予“相册读取”权限（选择“允许全部”），然后回到这里。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open LinkToMacOS on your phone, grant “Photo access” (choose “Allow all”), then come back here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンで LinkToMacOS を開き、「写真へのアクセス」を許可（「すべて許可」を選択）してから、ここに戻ってください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在手機上打開 LinkToMacOS，授予「照片讀取」權限（選擇「允許全部」），然後回到這裡。"
          }
        }
      }
    },
    "请确认手机和这台 Mac 在同一个网络，并且手机上的 LinkToMacOS 正在运行。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认手机和这台 Mac 在同一个网络，并且手机上的 LinkToMacOS 正在运行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure your phone and this Mac are on the same network and LinkToMacOS is running on your phone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンとこの Mac が同じネットワークにあり、スマートフォンで LinkToMacOS が動作していることを確認してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認手機和這台 Mac 在同一個網路，並且手機上的 LinkToMacOS 正在執行。"
          }
        }
      }
