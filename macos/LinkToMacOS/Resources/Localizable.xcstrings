            "value": "在 Mac 上顯示手機通知"
          }
        }
      }
    },
    "在一端复制文字，另一端直接粘贴。只同步连接之后的复制；密码管理器标为隐藏的内容不会发送。手机要连着增强服务，后台复制才能同步。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在一端复制文字，另一端直接粘贴。只同步连接之后的复制；密码管理器标为隐藏的内容不会发送。手机要连着增强服务，后台复制才能同步。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy text on one device and paste it on the other. Only text copied after connecting is shared, and content that password managers mark as hidden is never sent. Copies made in the background on the phone sync only while the enhanced service is running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一方でコピーしたテキストをもう一方でペーストできます。共有されるのは接続後にコピーしたテキストのみで、パスワードマネージャーが非表示とマークした内容は送信されません。スマートフォンのバックグラウンドでのコピーは、拡張サービスが動作中の場合のみ同期されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在一端拷貝文字，另一端直接貼上。只同步連線之後的拷貝；密碼管理器標為隱藏的內容不會傳送。手機要連著增強服務，後臺拷貝才能同步。"
          }
        }
      }
    },
    "在手机上拷贝 / 粘贴": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手机上拷贝 / 粘贴"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy / paste on the phone"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンでコピー／ペースト"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在手機上拷貝 / 貼上"
          }
        }
      }
    },
    "在手机上点“分享”，选 AirSend 或最上面一排的 Mac 名字。文件会存进“下载/AirSend”。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手机上点“分享”，选 AirSend 或最上面一排的 Mac 名字。文件会存进“下载/AirSend”。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the phone tap Share, then pick AirSend or your Mac’s name in the top row. Files are saved to Downloads/AirSend."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末で「共有」をタップし、AirSend または上段の Mac の名前を選びます。ファイルは「Downloads/AirSend」に保存されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在手機上點「分享」，選 AirSend 或最上面一排的 Mac 名字。檔案會存進「下載/AirSend」。"
          }
        }
      }
    },
    "在手机里新开一块屏幕，手机自己可以锁屏、关屏。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手机里新开一块屏幕，手机自己可以锁屏、关屏。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a separate screen inside the phone. The phone’s own screen can stay locked or off."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末の中に別の画面を作ります。端末自体の画面はロックしたりオフにしたりできます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在手機裡新開一塊螢幕，手機自己可以鎖屏、關屏。"
          }
        }
      }
    },
    "在访达中显示": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
