    "在 Mac 上显示手机通知": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上显示手机通知"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show phone notifications on this Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンの通知をこの Mac に表示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
