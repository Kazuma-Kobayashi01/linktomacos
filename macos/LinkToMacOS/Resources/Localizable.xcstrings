            "state": "translated",
            "value": "沒有找到 adb。可以在設定裡手動選擇。"
          }
        }
      }
    },
    "没有找到 adb。请安装 Android 平台工具（Android Studio 或 brew install android-platform-tools），或手动选择 adb。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有找到 adb。请安装 Android 平台工具（Android Studio 或 brew install android-platform-tools），或手动选择 adb。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "adb was not found. Install the Android platform tools (Android Studio, or brew install android-platform-tools), or choose adb manually."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "adb が見つかりません。Android プラットフォームツール（Android Studio、または brew install android-platform-tools）をインストールするか、adb を手動で選択してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有找到 adb。請安裝 Android 平臺工具（Android Studio 或 brew install android-platform-tools），或手動選擇 adb。"
          }
        }
      }
    },
    "没有检测到 USB 连接的手机。请用数据线连接，并在手机上开启“USB 调试”。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有检测到 USB 连接的手机。请用数据线连接，并在手机上开启“USB 调试”。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No phone detected over USB. Connect it with a cable and turn on “USB debugging” on the phone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "USB 接続のスマートフォンが見つかりません。ケーブルで接続し、スマートフォンで「USB デバッグ」をオンにしてください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有偵測到以 USB 連接的手機。請用傳輸線連接，並在手機上開啟「USB 偵錯」。"
          }
        }
      }
    },
    "没有照片": {
      "localizations": {
        "zh-Hans": {
