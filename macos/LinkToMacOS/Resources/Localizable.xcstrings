    "没有找到 adb。可以在设置里手动选择。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有找到 adb。可以在设置里手动选择。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "adb wasn’t found. You can choose it manually in Settings."
          }
        },
        "ja": {
          "stringUnit": {
