    "1 小时": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 小时"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Hour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 時間"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1 小時"
          }
        }
      }
    },
    "1. 手机：设置 → 关于手机 → 软件信息，连续点按“版本号”7 次，打开开发者选项。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 手机：设置 → 关于手机 → 软件信息，连续点按“版本号”7 次，打开开发者选项。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. On the phone: Settings → About phone → Software information, then tap “Build number” 7 times to enable Developer options."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1. スマートフォン：設定 → 端末情報 → ソフトウェア情報で「ビルド番号」を7回タップして、開発者向けオプションを有効にします。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 手機：設定 → 關於手機 → 軟體資訊，連續點按「版本號碼」7 次，開啟開發人員選項。"
          }
        }
      }
    },
    "2. 手机：设置 → 开发者选项 → 打开“USB 调试”。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 手机：设置 → 开发者选项 → 打开“USB 调试”。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. On the phone: Settings → Developer options → turn on “USB debugging”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2. スマートフォン：設定 → 開発者向けオプション →「USB デバッグ」をオンにします。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 手機：設定 → 開發人員選項 → 開啟「USB 偵錯」。"
          }
        }
      }
    },
    "24 小时": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "24 小时"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "24 Hours"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "24 時間"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "24 小時"
          }
        }
      }
    },
    "3. 三星手机：设置 → 安全和隐私 → 自动拦截器，需要关闭，否则会拦截 USB 调试命令。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 三星手机：设置 → 安全和隐私 → 自动拦截器，需要关闭，否则会拦截 USB 调试命令。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Samsung phones: turn off Settings → Security and privacy → Auto Blocker, or it will block USB debugging commands."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Samsung：設定 → セキュリティとプライバシー → オートブロッカーをオフにしてください。オンのままだと USB デバッグのコマンドがブロックされます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 三星手機：設定 → 安全性與隱私 → 自動封鎖程式，需要關閉，否則會攔截 USB 偵錯指令。"
          }
        }
      }
    },
    "6 小时": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "6 小时"
