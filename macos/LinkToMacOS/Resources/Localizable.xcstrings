    "1 小时": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 小时"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Hour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 時間"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1 小時"
          }
        }
      }
    },
    "1. 手机：设置 → 关于手机 → 软件信息，连续点按“版本号”7 次，打开开发者选项。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 手机：设置 → 关于手机 → 软件信息，连续点按“版本号”7 次，打开开发者选项。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. On the phone: Settings → About phone → Software information, then tap “Build number” 7 times to enable Developer options."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1. スマートフォン：設定 → 端末情報 → ソフトウェア情報で「ビルド番号」を7回タップして、開発者向けオプションを有効にします。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 手機：設定 → 關於手機 → 軟體資訊，連續點按「版本號碼」7 次，開啟開發人員選項。"
          }
        }
      }
    },
    "2. 手机：设置 → 开发者选项 → 打开“USB 调试”。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 手机：设置 → 开发者选项 → 打开“USB 调试”。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. On the phone: Settings → Developer options → turn on “USB debugging”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2. スマートフォン：設定 → 開発者向けオプション →「USB デバッグ」をオンにします。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 手機：設定 → 開發人員選項 → 開啟「USB 偵錯」。"
          }
        }
      }
    },
    "24 小时": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "24 小时"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "24 Hours"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "24 時間"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "24 小時"
          }
        }
      }
    },
    "3. 三星手机：设置 → 安全和隐私 → 自动拦截器，需要关闭，否则会拦截 USB 调试命令。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 三星手机：设置 → 安全和隐私 → 自动拦截器，需要关闭，否则会拦截 USB 调试命令。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Samsung phones: turn off Settings → Security and privacy → Auto Blocker, or it will block USB debugging commands."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Samsung：設定 → セキュリティとプライバシー → オートブロッカーをオフにしてください。オンのままだと USB デバッグのコマンドがブロックされます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 三星手機：設定 → 安全性與隱私 → 自動封鎖程式，需要關閉，否則會攔截 USB 偵錯指令。"
          }
        }
      }
    },
    "4. 用数据线连接电脑，手机弹出“允许 USB 调试吗？”时点允许。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "4. 用数据线连接电脑，手机弹出“允许 USB 调试吗？”时点允许。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Connect the phone to this Mac with a USB cable. When the phone asks “Allow USB debugging?”, tap Allow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4. USB ケーブルでスマートフォンを Mac に接続します。「USB デバッグを許可しますか？」と表示されたら許可をタップします。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "4. 用傳輸線連接電腦，手機跳出「允許 USB 偵錯嗎？」時點選允許。"
          }
        }
      }
    },
    "5. 点击“启动增强服务”。启动成功后可以拔掉数据线。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "5. 点击“启动增强服务”。启动成功后可以拔掉数据线。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5. Click “Start Enhanced Service”. Once it has started, you can unplug the cable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5. 「拡張サービスを起動」をクリックします。起動したらケーブルを外せます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "5. 點選「啟動增強服務」。啟動成功後即可拔掉傳輸線。"
          }
        }
      }
    },
