    "App 自带 adb，不用另外安装 Android 工具；想用自己的版本，可以手动选择。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 自带 adb，不用另外安装 Android 工具；想用自己的版本，可以手动选择。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app includes adb, so you don’t need to install the Android tools separately. You can still choose your own version."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリに adb が含まれているため、Android ツールを別途インストールする必要はありません。自分のバージョンを手動で選ぶこともできます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 自帶 adb，不用另外安裝 Android 工具；想用自己的版本，可以手動選擇。"
          }
        }
      }
    },
