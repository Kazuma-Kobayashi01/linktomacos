    "增强服务没有启动。手机上的日志：%@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强服务没有启动。手机上的日志：%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The enhanced service did not start. Log from the phone: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張サービスが起動しませんでした。スマートフォンのログ：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增強服務沒有啟動。手機上的日誌：%@"
          }
        }
      }
    },
    "增强服务没有在预期时间内启动。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强服务没有在预期时间内启动。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The enhanced service did not start in time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張サービスが時間内に起動しませんでした。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增強服務沒有在預期時間內啟動。"
          }
        }
      }
    },
    "增强服务运行在手机上，让投屏不需要每次授权，并且能真实地点按和滑动。用数据线连接电脑启动一次，之后拔掉也一直有效，直到手机重启。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强服务运行在手机上，让投屏不需要每次授权，并且能真实地点按和滑动。用数据线连接电脑启动一次，之后拔掉也一直有效，直到手机重启。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The enhanced service runs on your phone. It lets mirroring skip the approval prompt and use real taps and swipes. Start it once with a USB cable; it keeps working after you unplug until the phone restarts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張サービスはスマートフォン上で動作し、毎回の許可なしで、実際のタップやスワイプでミラーリングできるようにします。USB ケーブルで一度起動すれば、ケーブルを外しても、スマートフォンを再起動するまで動作し続けます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增強服務執行在手機上，讓螢幕鏡像不必每次授權，並能真實地點按和滑動。用傳輸線連接電腦啟動一次，之後拔掉也持續有效，直到手機重新開機。"
          }
        }
      }
    },
