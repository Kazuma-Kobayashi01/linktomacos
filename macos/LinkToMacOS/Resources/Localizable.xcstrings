    "手机还没有授权这台电脑。请在手机弹出的“允许 USB 调试吗？”里点允许。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机还没有授权这台电脑。请在手机弹出的“允许 USB 调试吗？”里点允许。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone hasn’t approved this Mac yet. Tap Allow on the “Allow USB debugging?” prompt on the phone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンがこの Mac をまだ許可していません。スマートフォンに表示される「USB デバッグを許可しますか？」で許可をタップしてください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機尚未授權這台電腦。請在手機跳出的「允許 USB 偵錯嗎？」中點選允許。"
          }
        }
      }
    },
    "手机重启后，需要再插一次数据线启动。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机重启后，需要再插一次数据线启动。"
